# Public client settings only. Placeholders - copy to .env.local and fill in.
# NEVER put a Supabase service-role key or any secret in a NEXT_PUBLIC_ variable.

# Backend host root only (no trailing slash and no /api/v1; the client appends it).
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid

# Supabase project URL and public anon key (used for sign-in/session only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Configure the backend separately: add the exact frontend origin(s) to
# CORS_ALLOWED_ORIGINS (for local development: http://localhost:3000).
